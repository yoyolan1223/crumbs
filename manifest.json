{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "Crumbs",
  "version": "0.4.1",
  "description": "__MSG_description__",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "__MSG_action_title__",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "sidePanel",
    "scripting",
    "favicon"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "extension_ids": [
        "*"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "__MSG_cmd_open__"
    },
    "show-trail": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "__MSG_cmd_trail__"
    }
  },
  "default_locale": "en"
}
